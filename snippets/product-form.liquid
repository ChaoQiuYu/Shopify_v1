{% form 'product', product, data-product-form: '', data-product-handle: product.handle, data-enable-history-state: 'true' %}
{% comment %} 
  <select name="id" v-model="form.id" id="variant_id"  class="form-control">
    {% for variant in product.variants %}
      <option
        {% if variant == current_variant %}selected="selected"{% endif %}
        {% unless variant.available %}disabled="disabled"{% endunless %}
        value="{{ variant.id }}">
          {{ variant.title }}
      </option>
    {% endfor %}
  </select> {% endcomment %}

<noscript>
  <select name="id">
    {% for variant in product.variants %}
      <option
        {% if variant == current_variant %}selected="selected"{% endif %}
        {% unless variant.available %}disabled="disabled"{% endunless %}
        value="{{ variant.id }}">
          {{ variant.title }}
      </option>
    {% endfor %}
  </select>
</noscript>

<div class="form-group">
    <div class="row align-items-end">
      {% comment %} <div class="col-md-6">
          <label for="Quantity" class="form-label">{{ 'products.product.quantity' | t }}</label>
          <input type="number" v-model="form.quantity" class="form-control" id="Quantity" name="quantity" value="1" min="1">
      </div> {% endcomment %}
      <div class="col-md-6" >
          <button
            type="button"
            @click="addToCart" //点击调用addToCart方法
            class="btn btn-primary"
            name="add"
            data-submit-button
            {% unless current_variant.available %} disabled="disabled" {% endunless %}
              style="width: 490px;background-color:#7069bc;justify-items:center;padding: 10px;">
              <span data-submit-button-text style="font-size:18px;font-weight:700">
                {% if current_variant.available %}
                  CLAIM OFFER
                {% else %}
                  {{ 'products.product.sold_out' | t }}
                {% endif %}
              </span>
          </button>

          <button
            type="button"
            class="btn btn-primary"
            name="add"
            data-submit-button
            {% unless current_variant.available %} disabled="disabled" {% endunless %}
              style="width: 490px;background-color:#7069bc;justify-items:center;padding: 10px;margin-top:10px">
              <span data-submit-button-text style="font-size:18px;font-weight:700">
                {% if current_variant.available %}
                  BUY IT NOW
                {% else %}
                  {{ 'products.product.sold_out' | t }}
                {% endif %}
              </span>
          </button>

          {% if product.tags.size > 0 %}
            <div class="product-single__tags">
              <p>
                Tags:
                {% for tag in product.tags %}
                {% assign tag_coll = '/collections/all/' | append: tag %}
                  {{ tag | capitalize | link_to: tag_coll }}{% unless forloop.last %},{% endunless %}
                {% endfor %}
              </p>
            </div>
          {% endif %}

      </div>
    </div>
    
</div>
{% endform %}